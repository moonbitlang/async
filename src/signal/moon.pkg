import {
  "moonbitlang/async/internal/event_loop",
}

#cfg(any(target="native", target="wasm"))
import {
  "moonbitlang/core/async/signal" @core_signal,
}

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/async/internal/test_util",
} for "test"

options(
  "allow-experimental-packages": true,
  targets: {
    "deprecated.mbt": [ "native", "wasm" ],
    "signal.mbt": [ "native", "wasm" ],
    "signal_test.mbt": [ "native", "wasm" ],
  },
)
